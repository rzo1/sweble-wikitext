<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>de.fau.cs.osr</groupId>
		<artifactId>tooling</artifactId>
		<version>3.0.8</version>
	</parent>

	<groupId>io.github.rzo1.org.sweble</groupId>
	<artifactId>sweble-parent</artifactId>
	<version>4.1.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>Sweble Parent</name>
	<inceptionYear>2010</inceptionYear>
	<description>
		The next generation Wiki platform project.
	</description>

	<modules>
		<module>sweble-engine-parent</module>
		<module>sweble-wikitext-components-parent</module>
		<module>sweble-wom3-parent</module>
	</modules>

	<!-- =================================================================== -->
	<!-- Properties - Properties - Properties - Properties - Properties - Pr -->
	<!-- =================================================================== -->

	<properties>
		<sweble-parent.path>${project.basedir}</sweble-parent.path>
		<sweble-parent.etc-path>${sweble-parent.path}/etc</sweble-parent.etc-path>
		<tooling.etc-path>${sweble-parent.etc-path}</tooling.etc-path>

		<!-- sweble currently does not conform :( -->
		<maven-checkstyle-plugin.skip>true</maven-checkstyle-plugin.skip>
		<maven-enforcer-plugin.skip>true</maven-enforcer-plugin.skip>

		<!-- Dependencies -->
		<osr-common.version>3.0.8</osr-common.version>
		<!-- Should be ${project.version} but that causes trouble with the release plugin -->
		<jaxb-api.version>4.0.5</jaxb-api.version>
		<jaxb-impl.version>4.0.9</jaxb-impl.version>

		<!-- override from osr parent -->
		<maven.compiler.source>11</maven.compiler.source>
		<maven.compiler.target>11</maven.compiler.target>

		<commons-io.version>2.20.0</commons-io.version>
		<commons-codec.version>1.19.0</commons-codec.version>
		<gson.version>2.13.1</gson.version>

		<!-- override outdated versions managed by the osr parent -->
		<commons-compress.version>1.28.0</commons-compress.version>
		<!-- XZ for commons-compress, which declares it as optional -->
		<xz.version>1.10</xz.version>
		<commons-jxpath.version>1.4.0</commons-jxpath.version>
		<commons-math3.version>3.6.1</commons-math3.version>
		<xercesImpl.version>2.12.2</xercesImpl.version>
		<xalan.version>2.7.3</xalan.version>
		<Saxon-HE.version>12.10</Saxon-HE.version>
		<rats-runtime.version>2.4.0</rats-runtime.version>

		<forbiddenapis-plugin.version>3.6</forbiddenapis-plugin.version>
		<maven-dependency-plugin.version>3.6.1</maven-dependency-plugin.version>
		<maven-surefire-plugin.version>3.2.2</maven-surefire-plugin.version>
	</properties>

	<!-- =================================================================== -->
	<!-- Dependency Management - Dependency Management - Dependency Manageme -->
	<!-- =================================================================== -->

	<dependencyManagement>
		<dependencies>

			<!-- =========================================================== -->
			<!-- OSR Common - OSR Common - OSR Common - OSR Common - OSR Com -->
			<!-- =========================================================== -->

			<!-- Utils -->
			<dependency>
				<groupId>de.fau.cs.osr.utils</groupId>
				<artifactId>utils</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Utils - Testing -->
			<dependency>
				<groupId>de.fau.cs.osr.utils</groupId>
				<artifactId>utils-testing</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Utils - GetOpt -->
			<dependency>
				<groupId>de.fau.cs.osr.utils</groupId>
				<artifactId>utils-getopt</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Parser Toolkit - Common -->
			<dependency>
				<groupId>de.fau.cs.osr.ptk</groupId>
				<artifactId>ptk-common</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Parser Toolkit - XPath -->
			<dependency>
				<groupId>de.fau.cs.osr.ptk</groupId>
				<artifactId>ptk-xpath</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Parser Toolkit - XML Tools -->
			<dependency>
				<groupId>de.fau.cs.osr.ptk</groupId>
				<artifactId>ptk-xml-tools</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- Parser Toolkit - JSON Tools -->
			<dependency>
				<groupId>de.fau.cs.osr.ptk</groupId>
				<artifactId>ptk-json-tools</artifactId>
				<version>3.0.8</version>
			</dependency>

			<!-- =========================================================== -->
			<!-- SWC - SWC - SWC - SWC - SWC - SWC - SWC - SWC - SWC - SWC - -->
			<!-- =========================================================== -->

			<!-- Sweble Wikitext Components - Sweble Wikitext Parser -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wikitext</groupId>
				<artifactId>swc-parser-lazy</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Sweble Wikitext Components - Engine -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wikitext</groupId>
				<artifactId>swc-engine</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Sweble Wikitext Components - Dump Reader -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wikitext</groupId>
				<artifactId>swc-dumpreader</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Sweble Wikitext Components - Article Cruncher -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wikitext</groupId>
				<artifactId>swc-article-cruncher</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- =========================================================== -->
			<!-- WOM v3 - WOM v3 - WOM v3 - WOM v3 - WOM v3 - WOM v3 - WOM v -->
			<!-- =========================================================== -->

			<!-- Sweble - WOM 3.0 Core -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wom3</groupId>
				<artifactId>sweble-wom3-core</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Sweble - WOM 3.0 JSON Tools -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wom3</groupId>
				<artifactId>sweble-wom3-json-tools</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- Sweble WOM 3.0 - SWC Adapter -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.wom3</groupId>
				<artifactId>sweble-wom3-swc-adapter</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- =========================================================== -->
			<!-- Engine - Engine - Engine - Engine - Engine - Engine - Engin -->
			<!-- =========================================================== -->

			<!-- Sweble Engine - Serialization -->
			<dependency>
				<groupId>io.github.rzo1.org.sweble.engine</groupId>
				<artifactId>sweble-engine-serialization</artifactId>
				<version>${project.version}</version>
			</dependency>

			<!-- =========================================================== -->
			<!-- XML - XML - XML - XML - XML - XML - XML - XML- XML - XML -  -->
			<!-- =========================================================== -->

			<dependency>
				<groupId>jakarta.xml.bind</groupId>
				<artifactId>jakarta.xml.bind-api</artifactId>
				<version>${jaxb-api.version}</version>
			</dependency>

			<dependency>
				<groupId>org.glassfish.jaxb</groupId>
				<artifactId>jaxb-runtime</artifactId>
				<version>${jaxb-impl.version}</version>
				<exclusions>
					<exclusion>
						<groupId>com.sun.activation</groupId>
						<artifactId>jakarta.activation</artifactId>
					</exclusion>
				</exclusions>
			</dependency>

			<!-- xalan 2.7.3 no longer declares its serializer dependency -->
			<dependency>
				<groupId>xalan</groupId>
				<artifactId>serializer</artifactId>
				<version>${xalan.version}</version>
			</dependency>

			<!-- ptk-common pulls in rats-runtime 1.15.0 -->
			<dependency>
				<groupId>xtc</groupId>
				<artifactId>rats-runtime</artifactId>
				<version>${rats-runtime.version}</version>
			</dependency>

			<dependency>
				<groupId>org.aspectj</groupId>
				<artifactId>aspectjrt</artifactId>
				<version>1.9.25.1</version>
			</dependency>

			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-collections4</artifactId>
				<version>4.6.0</version>
			</dependency>

			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-lang3</artifactId>
				<version>3.20.0</version>
			</dependency>

			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>2.0.19</version>
			</dependency>

			<dependency>
				<groupId>joda-time</groupId>
				<artifactId>joda-time</artifactId>
				<version>2.14.3</version>
			</dependency>

			<!-- XZ for Java -->
			<dependency>
				<groupId>org.tukaani</groupId>
				<artifactId>xz</artifactId>
				<version>${xz.version}</version>
			</dependency>

		</dependencies>
	</dependencyManagement>

	<build>

		<!-- =============================================================== -->
		<!-- Plugin Management - Plugin Management - Plugin Management - Plu -->
		<!-- =============================================================== -->

		<pluginManagement>
			<plugins>

				<!-- Check and format license headers -->
				<plugin>
					<groupId>com.mycila</groupId>
					<artifactId>license-maven-plugin</artifactId>
					<configuration>
						<header>${sweble-parent.etc-path}/apache-license-v2-header.txt</header>
						<validHeaders>
							<validHeader>${sweble-parent.etc-path}/apache-license-v2-header-no-copyright.txt</validHeader>
						</validHeaders>
						<excludes combine.children="append">
							<exclude>etc/apache-license-v2-header-no-copyright.txt</exclude>
							<exclude>etc/agpl-v3-header.txt</exclude>
							<exclude>etc/agpl-v3-header-no-copyright.txt</exclude>
							<exclude>sweble*/**</exclude>
						</excludes>
					</configuration>
				</plugin>

				<!-- Also forbid default locale and default charset APIs in main code -->
				<plugin>
					<groupId>de.thetaphi</groupId>
					<artifactId>forbiddenapis</artifactId>
					<executions>
						<execution>
							<id>check-for-default-locale-and-charset</id>
							<phase>verify</phase>
							<goals>
								<goal>check</goal>
							</goals>
							<configuration>
								<bundledSignatures combine.self="override">
									<bundledSignature>jdk-unsafe</bundledSignature>
								</bundledSignatures>
							</configuration>
						</execution>
					</executions>
				</plugin>

				<!-- Don't fail when building from a source archive without .git -->
				<plugin>
					<groupId>pl.project13.maven</groupId>
					<artifactId>git-commit-id-plugin</artifactId>
					<configuration>
						<failOnNoGitDirectory>false</failOnNoGitDirectory>
						<failOnUnableToExtractRepoInfo>false</failOnUnableToExtractRepoInfo>
					</configuration>
				</plugin>

			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.sonatype.central</groupId>
				<artifactId>central-publishing-maven-plugin</artifactId>
				<version>0.11.0</version>
				<extensions>true</extensions>
				<configuration>
					<publishingServerId>central</publishingServerId>
					<deploymentName>Sweble</deploymentName>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- =================================================================== -->
	<!-- More Project Information - More Project Information - More Project  -->
	<!-- =================================================================== -->

	<licenses>
		<license>
			<name>The Apache Software License, Version 2.0</name>
			<url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<!-- =================================================================== -->
	<!-- Environment Settings - Environment Settings - Environment Settings  -->
	<!-- =================================================================== -->

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/rzo1/sweble-wikitext/issues</url>
	</issueManagement>

	<scm>
		<connection>scm:git://git@github.com:rzo1/sweble-wikitext.git</connection>
		<developerConnection>scm:git://@github.com:rzo1/sweble-wikitext.git</developerConnection>
		<url>https://github.com/rzo1/sweble-wikitext</url>
		<tag>HEAD</tag>
	</scm>

    <reporting>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <reportSets>
                    <reportSet>
                        <id>aggregate</id>
                        <reports>
