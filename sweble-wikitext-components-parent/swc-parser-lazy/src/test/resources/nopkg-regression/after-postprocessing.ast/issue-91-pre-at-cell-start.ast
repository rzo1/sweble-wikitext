WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtTable(
		{P} rtd = RTD[ "{|" <o> "\n" <o> "|}" ]
		xmlAttributes = WtXmlAttributes[],
		body = WtBody[
			[0] = WtTableCaption(
				{P} rtd = RTD[ "|+" <o> "" <o> "" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtBody[
					[0] = "\n",
					[1] = WtSemiPre[ [0] = " caption pre" ],
					[2] = "\n"
				]
			),
			[1] = WtTableImplicitTableBody(
				body = WtBody[
					[0] = WtTableRow(
						{P} implicit = false
						{P} rtd = RTD[ "|-" <o> "\n" <o> "" ]
						xmlAttributes = WtXmlAttributes[],
						body = WtBody[
							[0] = WtTableHeader(
								{P} rtd = RTD[ "!" <o> "" <o> "" ]
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[
									[0] = "\n",
									[1] = WtSemiPre[ [0] = " header pre" ],
									[2] = "\n"
								]
							)
						]
					),
					[1] = WtTableRow(
						{P} implicit = false
						{P} rtd = RTD[ "|-" <o> "\n" <o> "" ]
						xmlAttributes = WtXmlAttributes[],
						body = WtBody[
							[0] = WtTableCell(
								{P} rtd = RTD[ "|" <o> "" <o> "" ]
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[
									[0] = "\n",
									[1] = WtSemiPre[ [0] = " cell pre" ],
									[2] = "\n"
								]
							),
							[1] = WtTableCell(
								{P} rtd = RTD[ "|" <o> " |" <o> "" ]
								xmlAttributes = WtXmlAttributes[
									[0] = WtXmlAttribute(
										{P} rtd = RTD[ " " <o> "=" <o> "" ]
										name = WtName[ [0] = "x" ],
										value = WtValue[ [0] = "y" ]
									)
								],
								body = WtBody[
									[0] = "\n",
									[1] = WtSemiPre[ [0] = " cell pre with attributes" ],
									[2] = "\n"
								]
							)
						]
					)
				]
			)
		]
	),
	[1] = "\n"
)
