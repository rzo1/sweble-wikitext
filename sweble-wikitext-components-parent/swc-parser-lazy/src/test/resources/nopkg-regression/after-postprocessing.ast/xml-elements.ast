WtParsedWikitextPage(
	{P} entityMap = {
		[0] = WtTagExtension(
				{P} name = "ref"
				{P} rtd = RTD[ "<ref" <o> ">" <o> "</ref>" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtTagExtensionBody("")
			)
	}
	{P} warnings = C[]
	[0] = WtParagraph[
		[0] = WtTagExtension(
			{P} name = "ref"
			{P} rtd = RTD[ "<ref" <o> ">" <o> "</ref>" ]
			xmlAttributes = WtXmlAttributes[],
			body = WtTagExtensionBody("")
		),
		[1] = "<</ref>"
	]
)
