WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtDefinitionList[
		[0] = WtDefinitionListTerm(
			{P} rtd = RTD[ ";" <o> "\n" ]
			[0] = " Term"
		),
		[1] = WtDefinitionListDef(
			{P} rtd = RTD[ ":" <o> "\n" ]
			[0] = " Definition"
		),
		[2] = WtDefinitionListDef(
			{P} rtd = RTD[ ":" <o> "" ]
			[0] = WtTable(
				{P} rtd = RTD[ " {|" <o> "\n" <o> "|}" ]
				xmlAttributes = WtXmlAttributes[
					[0] = WtXmlAttribute(
						{P} rtd = RTD[ " " <o> "=\"" <o> "\"" ]
						name = WtName[ [0] = "class" ],
						value = WtValue[ [0] = "wikitable" ]
					)
				],
				body = WtBody[
					[0] = WtTableImplicitTableBody(
						body = WtBody[
							[0] = WtTableRow(
								{P} implicit = true
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[
									[0] = WtTableHeader(
										{P} rtd = RTD[ "!" <o> "" <o> "" ]
										xmlAttributes = WtXmlAttributes[],
										body = WtBody[
											[0] = WtParagraph[ [0] = " Header" ],
											[1] = "\n"
										]
									)
								]
							),
							[1] = WtTableRow(
								{P} implicit = false
								{P} rtd = RTD[ "|-" <o> "\n" <o> "" ]
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[
									[0] = WtTableCell(
										{P} rtd = RTD[ "|" <o> "" <o> "" ]
										xmlAttributes = WtXmlAttributes[],
										body = WtBody[
											[0] = WtParagraph[ [0] = " Cell" ],
											[1] = "\n"
										]
									)
								]
							)
						]
					)
				]
			),
			[1] = " after table",
			[2] = WtDefinitionList(
				{P} rtd = RTD[ "\n" <o> "" ]
				[0] = WtDefinitionListDef(
					{P} rtd = RTD[ "::" <o> "\n" ]
					[0] = WtTable(
						{P} rtd = RTD[ "{|" <o> "\n" <o> "|}" ]
						xmlAttributes = WtXmlAttributes[],
						body = WtBody[
							[0] = WtTableImplicitTableBody(
								body = WtBody[
									[0] = WtTableRow(
										{P} implicit = true
										xmlAttributes = WtXmlAttributes[],
										body = WtBody[
											[0] = WtTableCell(
												{P} rtd = RTD[ "|" <o> "" <o> "" ]
												xmlAttributes = WtXmlAttributes[],
												body = WtBody[
													[0] = WtParagraph[ [0] = " Nested" ],
													[1] = "\n"
												]
											)
										]
									)
								]
							)
						]
					)
				)
			)
		),
		[3] = WtDefinitionListDef(
			{P} rtd = RTD[ ":" <o> "" ]
			[0] = " Last"
		)
	]
)
