WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtDefinitionList[
		[0] = WtDefinitionListDef(
			{P} rtd = RTD[ ":" <o> "" ]
			[0] = WtTable(
				{P} rtd = RTD[ "{|" <o> "\n" <o> "|}" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtBody[
					[0] = WtTableImplicitTableBody(
						body = WtBody[
							[0] = WtTableRow(
								{P} implicit = true
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[
									[0] = WtTableCell(
										{P} rtd = RTD[ "|" <o> "" <o> "" ]
										xmlAttributes = WtXmlAttributes[],
										body = WtBody[
											[0] = "\n",
											[1] = WtUnorderedList[
												[0] = WtListItem(
													{P} rtd = RTD[ "*" <o> "" ]
													[0] = " Item"
												)
											],
											[2] = "\n"
										]
									)
								]
							)
						]
					)
				]
			)
		)
	],
	[1] = "\n\n",
	[2] = WtParagraph[ [0] = "Text" ]
)
