		body = WtBody[
			[0] = WtXmlElement(
				{P} name = "colgroup"
				{P} rtd = RTD[ "<colgroup" <o> ">" <o> "</colgroup>" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtBody[
					[0] = WtXmlElement(
						{P} name = "col"
						{P} rtd = RTD[ "<col" <o> "/>" <o> "" ]
						xmlAttributes = WtXmlAttributes[
							[0] = WtXmlAttribute(
								{P} rtd = RTD[ " " <o> "=\"" <o> "\"" ]
								name = WtName[ [0] = "span" ],
