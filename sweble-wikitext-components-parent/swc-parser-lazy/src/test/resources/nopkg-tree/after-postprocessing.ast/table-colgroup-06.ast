WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[ Warning: <no location>: <no content> : 12.2.5.4.9 R16 @ WtText. ]
	[0] = WtParagraph[],
	[1] = "text",
	[2] = WtXmlElement(
		{P} name = "table"
		{P} rtd = RTD[ "<table" <o> ">" <o> "</table>" ]
		xmlAttributes = WtXmlAttributes[],
		body = WtBody[
			[0] = WtXmlElement(
				{P} name = "colgroup"
				{P} rtd = RTD[ "<colgroup" <o> ">" <o> "" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtBody[
					[0] = " ",
					[1] = WtXmlElement(
						{P} name = "col"
						{P} rtd = RTD[ "<col" <o> "/>" <o> "" ]
						xmlAttributes = WtXmlAttributes[],
						body = -
					)
				]
			),
			[1] = WtXmlElement(
				{A} repair = true
				{P} name = "colgroup"
				{P} rtd = RTD[ "" <o> "" <o> "</colgroup>" ]
				xmlAttributes = WtXmlAttributes[],
				body = WtBody[
					[0] = WtXmlElement(
						{P} name = "col"
						{P} rtd = RTD[ "<col" <o> "/>" <o> "" ]
						xmlAttributes = WtXmlAttributes[],
						body = -
					)
				]
			),
			[2] = WtTableImplicitTableBody(
				body = WtBody[
					[0] = WtXmlElement(
						{P} name = "tr"
						{P} rtd = RTD[ "<tr" <o> ">" <o> "</tr>" ]
						xmlAttributes = WtXmlAttributes[],
						body = WtBody[
							[0] = WtXmlElement(
								{P} name = "td"
								{P} rtd = RTD[ "<td" <o> ">" <o> "</td>" ]
								xmlAttributes = WtXmlAttributes[],
								body = WtBody[ [0] = "a" ]
							)
						]
					)
				]
			)
		]
	),
	[3] = "\n"
)
