WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtParagraph[ [0] = "Before\n" ],
	[1] = WtImageLink(
		{P} border = false
		{P} format = THUMBNAIL
		{P} hAlign = UNSPECIFIED
		{P} height = -1
		{P} rtd = RTD[ "[[" <o> "" <o> "]]" ]
		{P} upright = false
		{P} vAlign = MIDDLE
		{P} width = -1
		target = WtPageName[ [0] = "File:X.jpg" ],
		options = WtLinkOptions[
			[0] = WtLinkOptionKeyword(
				{P} keyword = "thumb"
				{P} rtd = RTD[ "|thumb" ]
			)
		]
	),
	[2] = "\n",
	[3] = WtParagraph[ [0] = "After\nmore after" ],
	[4] = "\n\n",
	[5] = WtParagraph[ [0] = "Next paragraph" ],
	[6] = "\n"
)
