WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtImStartTag(
		{P} name = "@p"
		xmlAttributes = WtXmlAttributes[]
	),
	[1] = WtImageLink(
		{P} border = false
		{P} format = FRAME
		{P} hAlign = LEFT
		{P} height = -1
		{P} rtd = RTD[ "[[" <o> "" <o> "]]" ]
		{P} upright = false
		{P} vAlign = MIDDLE
		{P} width = -1
		target = WtPageName[ [0] = "File:X.jpg" ],
		options = WtLinkOptions[
			[0] = WtLinkOptionKeyword(
				{P} keyword = "frame"
				{P} rtd = RTD[ "|frame" ]
			),
			[1] = WtLinkOptionKeyword(
				{P} keyword = "left"
				{P} rtd = RTD[ "|left" ]
			)
		]
	),
	[2] = " same line",
	[3] = WtNewline("\n"),
	[4] = WtImageLink(
		{P} border = false
		{P} format = UNRESTRAINED
		{P} hAlign = RIGHT
		{P} height = -1
		{P} rtd = RTD[ "[[" <o> "" <o> "]]" ]
		{P} upright = false
		{P} vAlign = MIDDLE
		{P} width = -1
		target = WtPageName[ [0] = "File:Y.jpg" ],
		options = WtLinkOptions[
			[0] = WtLinkOptionKeyword(
				{P} keyword = "right"
				{P} rtd = RTD[ "|right" ]
			)
		]
	),
	[5] = WtNewline("\n"),
	[6] = "Text",
	[7] = WtImEndTag(
		{P} name = "@p"
	),
	[8] = WtNewline("\n")
)
