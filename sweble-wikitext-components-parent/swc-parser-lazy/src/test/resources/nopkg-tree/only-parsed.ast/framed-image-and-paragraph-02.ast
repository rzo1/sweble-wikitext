WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtImStartTag(
		{P} name = "@p"
		xmlAttributes = WtXmlAttributes[]
	),
	[1] = "Before",
	[2] = WtNewline("\n"),
	[3] = WtImageLink(
		{P} border = false
		{P} format = THUMBNAIL
		{P} hAlign = UNSPECIFIED
		{P} height = -1
		{P} rtd = RTD[ "[[" <o> "" <o> "]]" ]
		{P} upright = false
		{P} vAlign = MIDDLE
		{P} width = -1
		target = WtPageName[ [0] = "File:X.jpg" ],
		options = WtLinkOptions[
			[0] = WtLinkOptionKeyword(
				{P} keyword = "thumb"
				{P} rtd = RTD[ "|thumb" ]
			)
		]
	),
	[4] = WtNewline("\n"),
	[5] = "After",
	[6] = WtNewline("\n"),
	[7] = "more after",
	[8] = WtImEndTag(
		{P} name = "@p"
	),
	[9] = WtNewline("\n"),
	[10] = WtNewline("\n"),
	[11] = WtImStartTag(
		{P} name = "@p"
		xmlAttributes = WtXmlAttributes[]
	),
	[12] = "Next paragraph",
	[13] = WtImEndTag(
		{P} name = "@p"
	),
	[14] = WtNewline("\n")
)
