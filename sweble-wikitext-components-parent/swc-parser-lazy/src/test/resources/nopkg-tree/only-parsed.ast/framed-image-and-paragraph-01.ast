WtParsedWikitextPage(
	{P} entityMap = -
	{P} warnings = C[]
	[0] = WtImStartTag(
		{P} name = "@p"
		xmlAttributes = WtXmlAttributes[]
	),
	[1] = WtImageLink(
		{P} border = false
		{P} format = THUMBNAIL
		{P} hAlign = UNSPECIFIED
		{P} height = -1
		{P} rtd = RTD[ "[[" <o> "" <o> "]]" ]
		{P} upright = false
		{P} vAlign = MIDDLE
		{P} width = -1
		target = WtPageName[ [0] = "File:X.jpg" ],
		options = WtLinkOptions[
			[0] = WtLinkOptionKeyword(
				{P} keyword = "thumb"
				{P} rtd = RTD[ "|thumb" ]
			)
		]
	),
	[2] = WtNewline("\n"),
	[3] = "Text",
	[4] = WtImEndTag(
		{P} name = "@p"
	),
	[5] = WtNewline("\n")
)
