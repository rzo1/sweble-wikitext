/*
 * XmlElement
 * ----------
 *
 *   This grammar recognizes start and end tags separately without matching them.
 *   Finding valid pairs of start and end tags is deferred to later processing.
 *
 *   Grammar:
 *     - '</' XmlName Ws* '>'
 *     - '<' XmlName XmlAttribute* Ws* "/>"
 *     - '<' XmlName XmlAttribute* Ws* ">"
 *
 *   Tags with the name of a tag extension that is not also an HTML element
 *   (e.g. nowiki, ref) are text: The preprocessor only leaves such a tag in
 *   the text if it has no closing tag or if it is a stray closing tag. Like
 *   MediaWiki, which escapes these tags, we must not turn them into an
 *   element that wraps the rest of the page. Tags like pre, which are also
 *   HTML elements, are recognized as elements.
 *
 */

module org.sweble.wikitext.parser.parser.XmlElement;

import org.sweble.wikitext.parser.utils.Whitespace as Whitespace;

import org.sweble.wikitext.parser.utils.XmlName;
import org.sweble.wikitext.parser.utils.XmlAttribute(Whitespace);




// -- Body ---------------------------------------------------------------------

body
{
  private boolean isTagExtensionName(String name)
  {
    return getState().getConfig().isValidExtensionTagName(name)
        && !org.sweble.wikitext.parser.postprocessor.ElementType.isKnownHtmlElementName(name);
  }
}




// -- XmlElement ---------------------------------------------------------------

WtNode XmlElement =
    "</" yyValue:XmlEndTag
  / '<'  yyValue:XmlStartTag
  / '<'
    {
      yyValue = nf.text("<");
    }
;

private inline WtNode XmlEndTag =
    name:XmlName &{ !isTagExtensionName(name) } ws:pWsStar '>'
    {
      yyValue = setRtd(
        nf.endTag(name),
        "</", name, ws, '>');
    }
    // FIXME: Add auto correction and/or warning generation
;

private inline WtNode XmlStartTag =
    name:XmlName &{ !isTagExtensionName(name) } attributes:AttributeStar ws:pWsStar "/>"
    {
      yyValue = setRtd(
        nf.emptyTag(name, attributes),
        "<", name, SEP, ws, "/>");
    }
  / name:XmlName &{ !isTagExtensionName(name) } attributes:AttributeStar ws:pWsStar '>'
    {
      yyValue = setRtd(
        nf.startTag(name, attributes),
        '<', name, SEP, ws, '>');
    }
    // FIXME: Add auto correction and/or warning generation
;

private inline WtXmlAttributes AttributeStar =
  yyValue:(&pWsPlus XmlAttributePlus)?
  {
    if (yyValue == null)
      yyValue = nf.emptyAttrs();
  }
;




// -- End of file --------------------------------------------------------------
