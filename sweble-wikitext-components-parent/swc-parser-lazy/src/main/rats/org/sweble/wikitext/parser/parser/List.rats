/*
 * Lists
 * -----
 *
 *   Grammar:
 *     - [*#:;]+ ListItemContentStar
 *
 *   Like MediaWiki a term (";") can be followed by its definition on the same
 *   line: "; term : definition". The first colon which is not part of other
 *   markup ends the term (see splitTermAndDefinition() below).
 *
 */

module org.sweble.wikitext.parser.parser.List;

import org.sweble.wikitext.parser.parser.Content;
import org.sweble.wikitext.parser.parser.State;
import org.sweble.wikitext.parser.parser.Table;
import org.sweble.wikitext.parser.parser.Whitespace;




// -- Body ---------------------------------------------------------------------

header
{
  import java.util.ArrayList;
  import java.util.Arrays;
  import java.util.HashSet;
  import java.util.Set;
  import java.util.Vector;
}

body
{
  @SuppressWarnings("serial")
  private static final class TempListItem
      extends
          WtTempNode
  {
    WtNodeList content;
    String rt0;
    WtNode rt1;
    String prefix;
  }

  public static class ListNode
  {
    public ListType type;

    public WtContentNode node;

    public ListNode(ListType type, WtContentNode node)
    {
      this.type = type;
      this.node = node;
    }

    public boolean comparePrefix(char ch)
    {
      switch (type)
      {
        case DEFINITION:
          return (ch == ';' || ch == ':');
        case ENUMERATION:
          return (ch == '#');
        case ITEMIZATION:
          return (ch == '*');
        default:
          return false;
      }
    }

    public static enum ListType
    {
      DEFINITION,
      ITEMIZATION,
      ENUMERATION,
    }
  }

  private WtNodeList getCurrentListContent(Vector<ListNode> listStack)
  {
    return listStack.lastElement().node;
  }

  private WtNodeList getLastItemContent(Vector<ListNode> listStack)
  {
    WtNodeList items = getCurrentListContent(listStack);
    return (WtContentNode) items.get(items.size() - 1);
  }

  private WtNode pushNewListItem(Vector<ListNode> listStack, char ch, WtNodeList content)
  {
    WtNode n = null;
    switch (ch)
    {
      case '*':
      case '#':
        n = nf.li(content);
        break;
      case ':':
        n = nf.dd(content);
        break;
      case ';':
        n = nf.dt(content);
        break;
    }
    getCurrentListContent(listStack).add(n);
    return n;
  }

  private boolean isLastItemTerm(Vector<ListNode> listStack)
  {
    WtNodeList items = getCurrentListContent(listStack);
    return !items.isEmpty() &&
        items.get(items.size() - 1).isNodeType(WtNode.NT_DEFINITION_LIST_TERM);
  }

  private void setItemRtd(WtNode item, Object... glue)
  {
    if (isGatherRtData())
      item.setRtd(glue);
  }

  private ListNode pushNewList(Vector<ListNode> listStack, char ch)
  {
    ListNode node = null;
    switch (ch)
    {
      case '*':
        node = new ListNode(ListNode.ListType.ITEMIZATION, nf.ul(null));
        break;
      case '#':
        node = new ListNode(ListNode.ListType.ENUMERATION, nf.ol(null));
        break;
      case ':':
      case ';':
        node = new ListNode(ListNode.ListType.DEFINITION, nf.dl(null));
        break;
    }

    if (!listStack.isEmpty())
      getLastItemContent(listStack).add(node.node);

    listStack.add(node);

    return node;
  }

  private WtRtData processListItem(Vector<ListNode> listStack, WtNodeList items, TempListItem p, WtRtData lastItemRtd)
  {
    int j;
    for (j = 0; j < p.prefix.length() && j < listStack.size(); ++j)
    {
      if (!listStack.get(j).comparePrefix(p.prefix.charAt(j)))
        break;
    }

    boolean closesLevels = (j < listStack.size());

    // pop closed list levels
    listStack.setSize(j);

    boolean addRoot = (j == 0);

    int last = p.prefix.length() - 1;

    /* Like MediaWiki we close an open term if a definition continues its
     * level and further levels are opened: in ";a\n:*b" the itemization
     * belongs to a definition, not to the term.
     */
    if (!closesLevels && j > 0 && j <= last &&
        p.prefix.charAt(j - 1) == ':' && isLastItemTerm(listStack))
      pushNewListItem(listStack, ':', null);

    if (p.rt0 != null && j > last && lastItemRtd != null)
      lastItemRtd.setField(1, p.rt0);

    /* Like MediaWiki each term that is opened on this line (including the
     * actual list item) ends at the first colon which is not part of other
     * markup. The rest of the line goes into a definition which follows the
     * term and which receives all further list levels. The first item of
     * the line carries the prefix, definitions carry the colon.
     */
    boolean prefixAssigned = false;

    WtNodeList content = p.content;

    // open new list levels
    for (int k = j; k <= last; ++k)
    {
      ListNode node = pushNewList(listStack, p.prefix.charAt(k));
      if (k == j && p.rt0 != null)
        node.node.setRtd(p.rt0, SEP);

      if (k < last)
      {
        WtNodeList[] split = (p.prefix.charAt(k) == ';') ?
            splitTermAndDefinition(content) : null;

        if (split != null)
        {
          WtNode term = pushNewListItem(listStack, ';', split[0]);
          if (prefixAssigned)
            setItemRtd(term, SEP);
          else
            setItemRtd(term, p.rt1, p.prefix, SEP);
          prefixAssigned = true;

          setItemRtd(pushNewListItem(listStack, ':', null), ":", SEP);

          content = split[1];
        }
        else
        {
          // TODO: Issue warning!
          pushNewListItem(listStack, p.prefix.charAt(k), null);
        }
      }
    }

    // push the actual list item
    char ch = p.prefix.charAt(last);

    WtNodeList[] split = (ch == ';') ? splitTermAndDefinition(content) : null;

    WtNode item = pushNewListItem(
        listStack,
        ch,
        (split != null) ? split[0] : content);

    if (prefixAssigned)
      setItemRtd(item, SEP);
    else
      setItemRtd(item, p.rt1, p.prefix, SEP);

    if (split != null)
    {
      item = pushNewListItem(listStack, ':', split[1]);
      setItemRtd(item, ":", SEP);
    }

    if (addRoot)
      items.add(listStack.firstElement().node);

    return item.getRtd();
  }

  private WtNodeList makeList(TempListItem first, Pair<TempListItem> tail)
  {
    Vector<ListNode> listStack = new Vector<ListNode>();

    WtNodeList items = nf.list();

    WtRtData lastItemRtd = processListItem(listStack, items, first, null);

    for (Pair<TempListItem> i = tail; !i.isEmpty(); i = i.tail())
    {
      TempListItem item = i.head();

      /*if (lastItem != null)
        lastItem.setField(1, item.rt0);*/

      lastItemRtd = processListItem(listStack, items, item, lastItemRtd);
    }

    return items;
  }

  /* The void elements known to MediaWiki, they are never closed.
   */
  private static final Set<String> VOID_ELEMENTS = new HashSet<String>(Arrays.asList(
      "area", "base", "basefont", "bgsound", "br", "col", "command", "embed",
      "frame", "hr", "image", "img", "input", "keygen", "link", "meta",
      "param", "source", "track", "wbr"));

  /**
   * Splits the content of a term at the first colon which is not part of
   * other markup, like MediaWiki's BlockLevelPass::findColonNoLinks().
   *
   * Colons in links, templates, URLs, tag attributes, comments, etc. are
   * part of their own nodes and never seen here. MediaWiki looks for the
   * colon after it has turned formatting into HTML tags. Therefore a colon
   * inside an unclosed XML element or inside bold or italic formatting does
   * not end the term either.
   *
   * @return The content of the term and of the definition or null if there
   *         is no such colon.
   */
  private WtNodeList[] splitTermAndDefinition(WtNodeList content)
  {
    if (content == null)
      return null;

    ArrayList<WtNode> nodes = new ArrayList<WtNode>();
    flatten(content, nodes);

    int openElements = 0;
    boolean italics = false;
    boolean bold = false;
    for (int i = 0; i < nodes.size(); ++i)
    {
      WtNode n = nodes.get(i);
      switch (n.getNodeType())
      {
        case WtNode.NT_TEXT:
        {
          String text = ((WtText) n).getContent();
          int colon = text.indexOf(':');
          if (colon == -1 || openElements > 0 || italics || bold)
            break;

          WtNodeList term = nf.list(nodes.subList(0, i));
          if (colon > 0)
            term.add(nf.text(text.substring(0, colon)));

          WtNodeList definition = nf.list();
          if (colon + 1 < text.length())
            definition.add(nf.text(text.substring(colon + 1)));
          definition.addAll(nodes.subList(i + 1, nodes.size()));

          return new WtNodeList[] { term, definition };
        }
        case WtNode.NT_XML_START_TAG:
          if (!VOID_ELEMENTS.contains(((WtXmlStartTag) n).getName().toLowerCase()))
            ++openElements;
          break;
        case WtNode.NT_XML_END_TAG:
          // MediaWiki ignores excess end tags
          if (openElements > 0)
            --openElements;
          break;
        case WtNode.NT_TICKS:
          switch (((WtTicks) n).getTickCount())
          {
            case 2:
              italics = !italics;
              break;
            case 3:
            case 4:
              // Four ticks are an apostrophe followed by bold ticks
              bold = !bold;
              break;
            default:
              // Excess ticks in front of five ticks are text
              italics = !italics;
              bold = !bold;
              break;
          }
          break;
        default:
          break;
      }
    }

    return null;
  }

  private static void flatten(WtNodeList list, ArrayList<WtNode> nodes)
  {
    for (WtNode n : list)
    {
      if (n.isNodeType(WtNode.NT_NODE_LIST))
        flatten((WtNodeList) n, nodes);
      else
        nodes.add(n);
    }
  }

}




// -- List --[ State Aware Memoization ]-------------------------------------

noinline transient WtNode List =
 ^{
    StateAwareResult r = (StateAwareResult) pListMemoized(yyBase);
    final WikitextParserContext context = getContext();
    Result yyResult = r.getResult(context);
    if (yyResult == null)
      yyResult = r.setResult(context, pListTransient(yyBase));
    if (returnTrue(r))
      return yyResult;
  }
;

noinline memoized WtNode ListMemoized =
 ^{
    Result yyResult = new StateAwareResult("List", getContext(), pListTransient(yyBase));
    if (returnTrue(yyResult))
      return yyResult;
  }
;




// -- List ------------------------------------------------------------------

noinline transient WtNode ListTransient =
  &{ accept(ParserAtoms.LIST) } first:ListItem tail:( &slEol ListItem )*
  {
    yyValue = makeList(first, tail);
  }
;

private noinline transient TempListItem ListItem =
  rt0:pEol? rt1:pTpStar item:ListItemPrefixAndContent
  {
    yyValue = item;
    yyValue.rt0 = rt0;
    yyValue.rt1 = rt1;
  }
;

/* A table can be indented by prefixing its opening line with one or more
 * colons (":{|"). Like MediaWiki we treat this as a table inside a definition
 * list definition. Only prefixes consisting solely of colons are recognized,
 * MediaWiki does not support "*{|" or "#{|" either. The table is parsed in the
 * scope surrounding the list since the list item scope only accepts inline
 * content. Whatever follows the table's closing "|}" on the same line is
 * regular list item content.
 */
private transient TempListItem ListItemPrefixAndContent =
    prefix:ListIndentPrefixStr &( pExtSpaceStar "{|" ) table:Table content:ListItemContentStar
    {
      yyValue = new TempListItem();
      yyValue.content = nf.list(table, content);
      yyValue.prefix = prefix;
    }
  / prefix:ListPrefixStr content:ListItemContentStar
    {
      yyValue = new TempListItem();
      yyValue.content = content;
      yyValue.prefix = prefix;
    }
;

private transient String ListIndentPrefixStr =
  [:]+
;

/* Like MediaWiki any combination of prefix characters is allowed, terms
 * included: ";;a" is a term nested in a term.
 */
private transient String ListPrefixStr =
  [*#:;]+
;

private inline stateful WtNodeList ListItemContentStar =
  {
    enter(ParserScopes.LIST_ITEM);
  }
  InlineContentStar
;




// -- End of file -------------------------------------------------------------
