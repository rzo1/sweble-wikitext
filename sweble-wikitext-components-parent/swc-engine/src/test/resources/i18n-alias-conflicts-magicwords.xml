<!--
  Synthetic excerpt of a siteinfo magicwords response modelled after
  ja.wikipedia.org. The entries are ordered so that registering the
  aliases in order of appearance would resolve every conflict the wrong
  way. See upstream sweble/sweble-wikitext#72.
-->
<api batchcomplete="">
	<query>
		<magicwords>
			<!-- Case-insensitive parser function "ns" listed before the
			     case-sensitive "namespace" whose optional colon variant
			     "名前空間:" clashes with ns' own name. -->
			<magicword name="ns"><aliases><alias>名前空間:</alias><alias>名空:</alias><alias>NS:</alias></aliases></magicword>
			<magicword name="namespace" case-sensitive=""><aliases><alias>名前空間</alias><alias>NAMESPACE</alias></aliases></magicword>
			<!-- "lc" generates "ABC:" from "ABC", "uc" reports "ABC:" itself. -->
			<magicword name="lc"><aliases><alias>ABC</alias><alias>LC:</alias></aliases></magicword>
			<magicword name="uc"><aliases><alias>ABC:</alias><alias>UC:</alias></aliases></magicword>
			<!-- "pagename" generates "XYZ" from "XYZ:", "sitename" reports "XYZ" itself. -->
			<magicword name="pagename" case-sensitive=""><aliases><alias>XYZ:</alias><alias>PAGENAME</alias></aliases></magicword>
			<magicword name="sitename" case-sensitive=""><aliases><alias>XYZ</alias><alias>SITENAME</alias></aliases></magicword>
		</magicwords>
	</query>
</api>
