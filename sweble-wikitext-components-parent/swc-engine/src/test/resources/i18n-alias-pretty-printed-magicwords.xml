<!--
  Pretty-printed siteinfo magicwords response: whitespace between the
  elements and a magic word without <aliases>.
-->
<api batchcomplete="">
	<query>
		<magicwords>
			<magicword name="redirect">
				<aliases>
					<alias>#WEITERLEITUNG</alias>
					<alias>#REDIRECT</alias>
				</aliases>
			</magicword>
			<magicword name="lc">
				<!-- A comment between the aliases -->
				<aliases>
					<alias>KLEIN:</alias>
					<alias>LC:</alias>
				</aliases>
			</magicword>
			<magicword name="noaliases" case-sensitive=""/>
		</magicwords>
	</query>
</api>
