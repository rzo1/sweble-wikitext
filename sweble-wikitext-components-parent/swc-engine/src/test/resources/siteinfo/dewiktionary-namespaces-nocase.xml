<!--
  Some namespaces of dewiktionary-siteinfo.xml without the case attribute.
  Used to test that the generator falls back to the case setting of the wiki
  (siprop=general).
-->
<api batchcomplete="">
	<query>
		<namespaces>
			<ns _idx="-1" id="-1" canonical="Special" xml:space="preserve">Spezial</ns>
			<ns _idx="0" id="0" content="" xml:space="preserve" />
			<ns _idx="1" id="1" subpages="" canonical="Talk" xml:space="preserve">Diskussion</ns>
			<ns _idx="2" id="2" subpages="" canonical="User" xml:space="preserve">Benutzer</ns>
			<ns _idx="3" id="3" subpages="" canonical="User talk" xml:space="preserve">Benutzer Diskussion</ns>
			<ns _idx="8" id="8" subpages="" canonical="MediaWiki" xml:space="preserve">MediaWiki</ns>
			<ns _idx="10" id="10" subpages="" canonical="Template" xml:space="preserve">Vorlage</ns>
		</namespaces>
	</query>
</api>
